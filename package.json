{
  "name": "@agenteca/core",
  "version": "0.1.0",
  "description": "Agenteca library: OpenAPM manifest and lockfile, version resolution, per-tool adapters, security scan, marketplaces.",
  "license": "Apache-2.0",
  "author": "Agenteca <agenteca@proton.me>",
  "homepage": "https://github.com/agenteca/agenteca-core#readme",
  "bugs": {
    "url": "https://github.com/agenteca/agenteca-core/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "openapm",
    "apm",
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "github-copilot",
    "cursor",
    "package-manager"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "CONFORMANCE.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenteca/agenteca-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "semver": "^7.6.3",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
